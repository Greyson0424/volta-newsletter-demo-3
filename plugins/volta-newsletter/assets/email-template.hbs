<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><title>{{title}}</title>
<style>@media only screen and (max-width:640px){.wrap{width:100%!important}.pad{padding-left:22px!important;padding-right:22px!important}.feature-image,.feature-copy{display:block!important;width:100%!important}.feature-image img{width:100%!important;max-width:100%!important}.feature-copy{padding:18px 0 0!important}.logo{width:210px!important}}</style></head>
<body style="margin:0;padding:0;background:#000;color:#fff;font-family:Arial,Helvetica,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{preheader}}</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#000;"><tr><td align="center">
<table class="wrap" role="presentation" width="620" cellspacing="0" cellpadding="0" border="0" style="width:620px;max-width:620px;background:#000;">
<tr><td class="pad" align="center" style="padding:44px 34px 26px;"><img class="logo" src="https://voltaeffect.com/assets/volta-logo.svg" width="245" alt="VOLTA" style="display:block;width:245px;max-width:80%;height:auto;border:0;"></td></tr>
<tr><td class="pad" style="padding:18px 34px 28px;color:#fff;font-size:16px;line-height:1.65;"><p style="margin:0 0 18px;font-weight:bold;">{{greeting}}</p>{{{openingHtml}}}<p style="margin:18px 0 0;color:#bdbdbd;font-size:13px;">About {{readingMinutes}} min read</p></td></tr>
<tr><td style="height:5px;background:#09d6e8;background-image:linear-gradient(90deg,#02d9ea 0%,#2bec91 34%,#ffe047 67%,#ff4c92 100%);font-size:0;line-height:0;">&nbsp;</td></tr>

{{#if communityWins.length}}<tr><td class="pad" style="padding:34px 34px 14px;"><h2 style="margin:0;color:#fff;font-size:29px;line-height:1.15;">Community updates &amp; opportunities</h2></td></tr>
{{#each communityWins}}<tr><td class="pad" style="padding:18px 34px 28px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
{{#if hasImage}}<td class="feature-image" width="245" valign="top" style="width:245px;"><img src="{{imageUrl}}" data-newsletter-image="true" data-image-source="{{imageSource}}" width="245" alt="{{imageAlt}}" style="display:block;width:245px;max-width:245px;height:auto;border:0;"></td>{{/if}}
<td class="feature-copy" valign="top" style="padding:0 0 0 24px;"><h3 style="margin:0 0 10px;color:#fff;font-size:21px;line-height:1.25;">{{headline}}</h3><p style="margin:0 0 13px;color:#d4d4d4;font-size:14px;line-height:1.55;">{{summary}}</p><a href="{{url}}" style="color:#fff;font-size:14px;font-weight:bold;text-decoration:underline;">Read more</a></td>
</tr></table></td></tr>{{/each}}{{/if}}

{{#if events.length}}<tr><td style="height:5px;background:#09d6e8;background-image:linear-gradient(90deg,#02d9ea 0%,#2bec91 34%,#ffe047 67%,#ff4c92 100%);font-size:0;line-height:0;">&nbsp;</td></tr><tr><td class="pad" style="padding:34px 34px 14px;"><h2 style="margin:0;color:#fff;font-size:29px;line-height:1.15;">Events &amp; Networking Opportunities</h2></td></tr>
{{#each events}}<tr><td class="pad" style="padding:18px 34px 30px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
{{#if hasImage}}<td class="feature-image" width="245" valign="top" style="width:245px;"><img src="{{imageUrl}}" data-newsletter-image="true" data-image-source="{{imageSource}}" width="245" alt="{{imageAlt}}" style="display:block;width:245px;max-width:245px;height:auto;border:0;"></td>{{/if}}
<td class="feature-copy" valign="top" style="padding:0 0 0 24px;"><p style="margin:0 0 7px;color:#5ce6ee;font-size:12px;font-weight:bold;text-transform:uppercase;">{{date}}{{#if location}} · {{location}}{{/if}}</p><h3 style="margin:0 0 10px;color:#fff;font-size:21px;line-height:1.25;">{{title}}</h3><p style="margin:0 0 13px;color:#d4d4d4;font-size:14px;line-height:1.55;">{{summary}}</p><a href="{{url}}" style="color:#fff;font-size:14px;font-weight:bold;text-decoration:underline;">Register</a>{{#if googleCalendarUrl}}<p style="margin:12px 0 0;font-size:12px;"><a href="{{googleCalendarUrl}}" style="color:#5ce6ee;">Google Calendar</a> &nbsp; <a href="{{outlookCalendarUrl}}" style="color:#5ce6ee;">Outlook Calendar</a></p>{{/if}}</td>
</tr></table></td></tr>{{/each}}{{/if}}

{{#if pastEvents.length}}<tr><td style="height:5px;background:#09d6e8;background-image:linear-gradient(90deg,#02d9ea 0%,#2bec91 34%,#ffe047 67%,#ff4c92 100%);font-size:0;line-height:0;">&nbsp;</td></tr><tr><td class="pad" style="padding:34px 34px 14px;"><h2 style="margin:0;color:#fff;font-size:29px;line-height:1.15;">Past Events Roundup</h2></td></tr>
{{#each pastEvents}}<tr><td class="pad" style="padding:18px 34px 28px;">{{#if hasImage}}<img src="{{imageUrl}}" data-newsletter-image="true" data-image-source="{{imageSource}}" width="552" alt="{{imageAlt}}" style="display:block;width:100%;max-width:552px;height:auto;border:0;margin:0 0 18px;">{{/if}}<h3 style="margin:0 0 9px;color:#fff;font-size:21px;line-height:1.25;">{{title}}</h3><p style="margin:0 0 8px;color:#5ce6ee;font-size:12px;font-weight:bold;text-transform:uppercase;">{{date}}</p><p style="margin:0 0 12px;color:#d4d4d4;font-size:14px;line-height:1.55;">{{summary}}</p><a href="{{url}}" style="color:#fff;font-size:14px;font-weight:bold;text-decoration:underline;">See the recap</a></td></tr>{{/each}}{{/if}}

{{#if callToAction}}<tr><td style="height:5px;background:#09d6e8;background-image:linear-gradient(90deg,#02d9ea 0%,#2bec91 34%,#ffe047 67%,#ff4c92 100%);font-size:0;line-height:0;">&nbsp;</td></tr><tr><td class="pad" align="center" style="padding:38px 34px;"><h2 style="margin:0 0 10px;color:#fff;font-size:26px;">{{callToAction.heading}}</h2><p style="margin:0 auto 18px;max-width:480px;color:#d4d4d4;font-size:15px;line-height:1.55;">{{callToAction.body}}</p>{{#if callToAction.deadline}}<p style="margin:0 0 18px;color:#fff;font-size:13px;font-weight:bold;">Deadline: {{callToAction.deadline}}</p>{{/if}}<a href="{{callToAction.url}}" style="display:inline-block;background:#fff;color:#000;padding:13px 22px;font-size:14px;font-weight:bold;text-decoration:none;">{{callToAction.label}}</a></td></tr>{{/if}}

<tr><td class="pad" align="center" style="padding:34px;background:#000;border-top:1px solid #333;color:#aaa;font-size:12px;line-height:1.65;"><p style="margin:0 0 8px;color:#fff;font-weight:bold;">VOLTA · Where builders get built.</p><p style="margin:0 0 8px;">1800 Argyle Street, Suite 801, Halifax, NS B3J 3N8 · (902) 702-0194</p><p style="margin:0 0 8px;"><a href="https://voltaeffect.com" style="color:#5ce6ee;">Website</a> · <a href="https://voltaeffect.com/contact" style="color:#5ce6ee;">Contact</a> · <a href="mailto:contact@voltaeffect.com" style="color:#5ce6ee;">Email</a></p><p style="margin:0 0 12px;"><a href="https://www.linkedin.com/company/voltaeffect" style="color:#5ce6ee;">LinkedIn</a> · <a href="https://www.instagram.com/voltaeffect/" style="color:#5ce6ee;">Instagram</a> · <a href="https://www.facebook.com/voltaeffect/" style="color:#5ce6ee;">Facebook</a></p><p style="margin:0;"><a href="*|UPDATE_PROFILE|*" style="color:#aaa;">Update preferences</a> · <a href="*|UNSUB|*" style="color:#aaa;">Unsubscribe</a></p></td></tr>
</table></td></tr></table></body></html>
