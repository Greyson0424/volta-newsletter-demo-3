<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{title}}</title>
</head>
<body style="margin:0;padding:0;background:#050506;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{preheader}}</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#050506;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#101013;border:1px solid #24242A;border-radius:20px;overflow:hidden;">
        <tr><td style="padding:32px 32px 22px;background:#050506;border-bottom:3px solid #05D9E7;">
          <img src="https://voltaeffect.com/assets/volta-logo.svg" width="154" alt="VOLTA" style="display:block;width:154px;max-width:50%;height:auto;border:0;">
          <p style="margin:22px 0 6px;color:#65E7EF;font-size:13px;font-weight:bold;letter-spacing:1.4px;text-transform:uppercase;">{{monthLabel}}</p>
          <h1 style="margin:0;color:#FFFFFF;font-size:34px;line-height:1.12;">{{title}}</h1>
        </td></tr>
        <tr><td style="padding:30px 32px;color:#FFFFFF;font-size:17px;line-height:1.65;">{{{openingHtml}}}</td></tr>
        {{#if communityWins.length}}
        <tr><td style="padding:6px 32px 14px;"><h2 style="margin:0;color:#05D9E7;font-size:24px;">Community wins</h2></td></tr>
        {{#each communityWins}}
        <tr><td style="padding:0 32px 18px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#050506;border:1px solid #292930;border-radius:14px;">
            <tr><td style="padding:22px;">
              <h3 style="margin:0 0 9px;color:#FFFFFF;font-size:19px;line-height:1.3;">{{headline}}</h3>
              <p style="margin:0 0 14px;color:#B8BEC7;font-size:15px;line-height:1.6;">{{summary}}</p>
              <a href="{{url}}" style="color:#65E7EF;font-size:14px;font-weight:bold;text-decoration:underline;">Read the source</a>
            </td></tr>
          </table>
        </td></tr>
        {{/each}}
        {{/if}}
        {{#if events.length}}
        <tr><td style="padding:12px 32px 14px;"><h2 style="margin:0;color:#05D9E7;font-size:24px;">What's happening at VOLTA</h2></td></tr>
        {{#each events}}
        <tr><td style="padding:0 32px 18px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-left:4px solid #6100FF;background:#050506;">
            <tr><td style="padding:18px 20px;">
              <p style="margin:0 0 6px;color:#65E7EF;font-size:13px;font-weight:bold;text-transform:uppercase;">{{date}}{{#if location}} · {{location}}{{/if}}</p>
              <h3 style="margin:0 0 8px;color:#FFFFFF;font-size:19px;">{{title}}</h3>
              <p style="margin:0 0 14px;color:#B8BEC7;font-size:15px;line-height:1.55;">{{summary}}</p>
              <a href="{{url}}" style="display:inline-block;background:#05D9E7;color:#050506;padding:11px 17px;border-radius:8px;font-size:14px;font-weight:bold;text-decoration:none;">Event details</a>
              {{#if googleCalendarUrl}}<a href="{{googleCalendarUrl}}" style="display:inline-block;margin:8px 6px 0 0;border:1px solid #65E7EF;color:#65E7EF;padding:9px 13px;border-radius:8px;font-size:13px;font-weight:bold;text-decoration:none;">Google Calendar</a>{{/if}}
              {{#if outlookCalendarUrl}}<a href="{{outlookCalendarUrl}}" style="display:inline-block;margin:8px 0 0;border:1px solid #65E7EF;color:#65E7EF;padding:9px 13px;border-radius:8px;font-size:13px;font-weight:bold;text-decoration:none;">Outlook Calendar</a>{{/if}}
            </td></tr>
          </table>
        </td></tr>
        {{/each}}
        {{/if}}
        {{#if callToAction}}
        <tr><td style="padding:14px 32px 34px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#6100FF;border-radius:14px;">
            <tr><td align="center" style="padding:25px 22px;">
              <h2 style="margin:0 0 8px;color:#FFFFFF;font-size:22px;">{{callToAction.heading}}</h2>
              <p style="margin:0 0 17px;color:#FFFFFF;font-size:15px;line-height:1.55;">{{callToAction.body}}</p>
              {{#if callToAction.deadline}}<p style="margin:0 0 17px;color:#FFFFFF;font-size:13px;font-weight:bold;">Respond by {{callToAction.deadline}}</p>{{/if}}
              <a href="{{callToAction.url}}" style="display:inline-block;background:#FFFFFF;color:#101013;padding:12px 18px;border-radius:8px;font-weight:bold;text-decoration:none;">{{callToAction.label}}</a>
            </td></tr>
          </table>
        </td></tr>
        {{/if}}
        <tr><td style="padding:26px 32px;background:#050506;border-top:1px solid #24242A;color:#B8BEC7;font-size:12px;line-height:1.6;text-align:center;">
          <p style="margin:0 0 8px;color:#FFFFFF;font-weight:bold;">VOLTA · Where builders get built.</p>
          <p style="margin:0 0 8px;">1800 Argyle Street, Suite 801, Halifax, NS B3J 3N8 · (902) 702-0194</p>
          <p style="margin:0 0 8px;"><a href="https://voltaeffect.com" style="color:#65E7EF;">Website</a> · <a href="https://voltaeffect.com/contact" style="color:#65E7EF;">Contact</a> · <a href="mailto:contact@voltaeffect.com" style="color:#65E7EF;">Email</a></p>
          <p style="margin:0 0 12px;"><a href="https://www.linkedin.com/company/voltaeffect" style="color:#65E7EF;">LinkedIn</a> · <a href="https://www.instagram.com/voltaeffect/" style="color:#65E7EF;">Instagram</a> · <a href="https://www.facebook.com/voltaeffect/" style="color:#65E7EF;">Facebook</a></p>
          <p style="margin:0;"><a href="*|UPDATE_PROFILE|*" style="color:#B8BEC7;">Update preferences</a> · <a href="*|UNSUB|*" style="color:#B8BEC7;">Unsubscribe</a></p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
